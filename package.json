{
  "name": "toko-extension",
  "version": "4.2.0",
  "type": "module",
  "scripts": {
    "build": "tsx build.ts",
    "build:api": "npm --prefix api install --omit=dev && npm run build && mkdir -p api/dist && cp dist/bundle.js api/dist/bundle.js",
    "start": "node api/src/server.js"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.25.0",
    "jszip": "^3.10.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "puppeteer-real-browser": "^1.4.4"
  }
}
