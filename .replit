modules = ["nodejs-20"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Toko API"

[[workflows.workflow]]
name = "Toko API"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm --prefix api start"
waitForPort = 8099

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 8099
externalPort = 80
