{
  "id": "tatakai.extension.toko",
  "name": "Toko",
  "type": "custom",
  "version": "3.0.0",
  "author": "Snozxyx",
  "description": "The official all-in-one Tatakai extension. Primary streaming via Nebula (AniList-keyed, direct HLS), plus anime direct streaming (Animepahe, Anikoto, Anizone, Animeya, Toonstream, Reanime, Aniworld, 4Anime, Animelok, Animesalt, Animeheaven, AnimeBLkom, DesiDub), movie/TV streaming via MovieBox, torrent discovery (Nyaa, Animetosho, SubPlease, Seadex, nekoBT, AniLiberty), and manga reading (Animesama, AsuraScan, Atsumaru, AllManga, MangaFire).",
  "categories": [
    "Anime Stream",
    "Torrent",
    "Manga"
  ],
  "capabilities": [
    "manga",
    "preview"
  ],
  "apiServer": {
    "namespace": "toko",
    "contract": "streaming-sources-v3",
    "routes": [
      "sources",
      "stream",
      "torrent",
      "download"
    ],
    "healthPath": "/health"
  },
  "sideloaded": true,
